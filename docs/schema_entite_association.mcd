USER: id, username, email, password
ROLE: id, name
TOURNAMENT: id, name, description, maxParticipants, format, status, startDate, registationStartDate, registrationEndDate
TEAM: id, name, numberOfWins
PARTICIPANT: id
PHASE: id, type, orderIndex
ROUND: id, type, orderIndex
MATCH: id, score1, score2, status, scheduleDate

HAS_ROLE, 0N ROLE, 11 USER
ORGANIZE, 0N USER, 11 TOURNAMENT
LEAD, 0N USER, 11 TEAM
JOIN, 0N USER, 0N TEAM
REGISTER_USER, 0N USER, 0N TOURNAMENT: id, registerDate, status
REGISTER_TEAM, 0N TEAM, 0N TOURNAMENT: id, registerDate, status

PARTICIPATE, 0N TOURNAMENT, 11 PARTICIPANT
PARTICIPATE_USER, 0N USER, 01 PARTICIPANT
PARTICIPATE_TEAM, 0N TEAM, 01 PARTICIPANT
COMPOSE, 0N TOURNAMENT, 11 PHASE
CONTAIN, 0N PHASE, 11 ROUND
GENERATE, 0N ROUND, 11 MATCH

WIN, 0N PARTICIPANT, 01 MATCH
PARTICIPANT_1, 0N PARTICIPANT, 11 MATCH
PARTICIPANT_2, 0N PARTICIPANT, 11 MATCH